OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5

MCP_SERVER_NAME=research-mcp-server
MCP_SERVER_VERSION=0.1.0

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mcp_research
POSTGRES_USER=mcp_user
POSTGRES_PASSWORD=mcp_password
POSTGRES_SSL=false

POSTGRES_QUERY_TIMEOUT_MS=3000
TOOL_MAX_LIMIT=50

# Lokalne REST API (aplikacja: src/rest-api/)
REST_API_PORT=4100

# Sciezka binarki Blendera - zapisywana automatycznie przez
# scripts/setup/windows/install_blender.ps1 (wersja przypieta w config/blender/VERSION)
BLENDER_PATH=

# Most WLASNEGO serwera Blender MCP (addon mcp_eval_addon.py w Blenderze GUI).
# Gotowiec ahujasid uzywa :9876 - oba mosty wspolistnieja w jednej instancji Blendera.
# Zmienne opcjonalne (domyslne wartosci ponizej); start mostow: scripts/run/start_blender_bridge.ps1
# MCP_EVAL_BLENDER_HOST=127.0.0.1
# MCP_EVAL_BLENDER_PORT=9877
# BLENDER_COMMAND_TIMEOUT_MS=15000
# BLENDER_RENDER_TIMEOUT_MS=120000

# OPCJONALNE klucze API dla zewnetrznych frameworkow ewaluacyjnych.
# Platne API sa poza zakresem podstawowym projektu - przebiegi z nimi
# oznaczac w wynikach (metadata.model / evaluationSource). mcp-gating-eval i deepeval
# dzialaja z lokalna Ollama bez kluczy.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Campaigns use generated .env.test.local from npm run setup:test-db.
# It contains POSTGRES_URL_ADMIN, POSTGRES_URL_RO, POSTGRES_URL_RW,
# MCP_EVAL_DATABASE and MCP_EVAL_REQUIRE_ROLES=1. No real credentials needed.
